# change window focus within space
alt + ctrl - j : yabai -m window --focus south
alt + ctrl - k : yabai -m window --focus north
alt + ctrl - h : yabai -m window --focus west
alt + ctrl - l : yabai -m window --focus east

#change focus between external displays (left and right)
alt + ctrl - s: yabai -m display --focus west
alt + ctrl - g: yabai -m display --focus east

# rotate layout clockwise
shift + alt + ctrl - r : yabai -m space --rotate 270

# toggle window float
shift + alt + ctrl - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# maximize a window
shift + alt + ctrl - m : yabai -m window --toggle zoom-fullscreen

# balance out tree of windows (resize to occupy same area)
shift + alt + ctrl - e : yabai -m space --balance

# swap windows
# shift + alt - j : yabai -m window --swap south
# shift + alt - k : yabai -m window --swap north
# shift + alt - h : yabai -m window --swap west
# shift + alt - l : yabai -m window --swap east
#
# move window and split
# ctrl + alt - j : yabai -m window --warp south
# ctrl + alt - k : yabai -m window --warp north
# ctrl + alt - h : yabai -m window --warp west
# ctrl + alt - l : yabai -m window --warp east
#
# move window to display left and right
shift + alt + ctrl - s : yabai -m window --display west; yabai -m display --focus west;
shift + alt + ctrl - g : yabai -m window --display east; yabai -m display --focus east;

#move window to prev and next space
shift + alt + ctrl - p : yabai -m window --space prev;
shift + alt + ctrl - n : yabai -m window --space next;

# move window to space
shift + alt + ctrl - 1 : yabai -m window --space 1;
shift + alt + ctrl - 2 : yabai -m window --space 2;
shift + alt + ctrl - 3 : yabai -m window --space 3;
shift + alt + ctrl - 4 : yabai -m window --space 4;
shift + alt + ctrl - 5 : yabai -m window --space 5;
shift + alt + ctrl - 6 : yabai -m window --space 6;
shift + alt + ctrl - 7 : yabai -m window --space 7;
shift + alt + ctrl - 8 : yabai -m window --space 8;
shift + alt + ctrl - 9 : yabai -m window --space 9;
